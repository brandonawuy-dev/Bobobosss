-- POSITION TAB
--==================================================

local PositionTab = Window:CreateTab("Position", 4483362458)

PositionTab:CreateSection("Boss Zone Position")

PositionTab:CreateToggle({
    Name = "Lock Position",
    CurrentValue = Config.LockPosition,

    Callback = function(Value)
        Config.LockPosition = Value

