-- HUNTER TAB
--==================================================

local HunterTab = Window:CreateTab("Hunter", 4483362458)

HunterTab:CreateSection("Main Controls")

HunterTab:CreateToggle({
    Name = "Master Automation",
    CurrentValue = Config.MasterEnabled,

    Callback = function(Value)
        Config.MasterEnabled = Value

        if Value then
            StartHunter()
        else
            StopHunter()
        end
    end
})

HunterTab:CreateDropdown({
    Name = "Select Boss",
    Options = BossOptions,
    CurrentOption = {Config.SelectedBoss},
    MultipleOptions = false,

    Callback = function(Option)
        local Selected = Option

        if type(Option) == "table" then
            Selected = Option[1]
        end

        if not BossMapping[Selected] then
            return
        end

        Config.SelectedBoss = Selected

        SaveConfig()

        Notify("Boss Selected", Selected)

        RestartHunter()
    end
})

HunterTab:CreateToggle({
    Name = "Auto Target",
    CurrentValue = Config.AutoTargetEnabled,

    Callback = function(Value)
        Config.AutoTargetEnabled = Value
        SaveConfig()

        if not Value then
            CurrentTarget = nil
        end
    end
})

HunterTab:CreateToggle({
    Name = "Auto Fire",
    CurrentValue = Config.AutoFireEnabled,

    Callback = function(Value)
        Config.AutoFireEnabled = Value
        SaveConfig()

        if Value and Config.MasterEnabled then
            StartAutoFire()
        else
            StopAutoFire()
        end
    end
})

HunterTab:CreateSlider({
    Name = "Auto Fire Interval",
    Range = {0.21, 2},
    Increment = 0.01,
    Suffix = "Seconds",
    CurrentValue = Config.AutoFireInterval,

    Callback = function(Value)
        Config.AutoFireInterval = Value
        SaveConfig()

        if Config.MasterEnabled and Config.AutoFireEnabled then
            StartAutoFire()
        end
    end
})

HunterTab:CreateSection("Server Controls")

HunterTab:CreateToggle({
    Name = "Auto Server Hop",
    CurrentValue = Config.AutoServerHop,

    Callback = function(Value)
        Config.AutoServerHop = Value
        SaveConfig()
    end
})

HunterTab:CreateSlider({
    Name = "Empty Server Recheck Delay",
    Range = {1, 10},
    Increment = 1,
    Suffix = "Seconds",
    CurrentValue = Config.EmptyServerDelay,

    Callback = function(Value)
        Config.EmptyServerDelay = Value
        SaveConfig()
    end
})

HunterTab:CreateButton({
    Name = "Save Configuration",

    Callback = function()
        SaveConfig()
        Notify("Configuration", "Settings saved.")
    end
})

